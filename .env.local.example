# Supabase — copy from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used for invite links and password reset redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key

# Paystack — https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key
PAYSTACK_SECRET_KEY=sk_test_your-secret-key

# Platform admin emails (comma-separated)
PLATFORM_ADMIN_EMAILS=brendanmebson@gmail.com

# Optional: allow specific personal emails during dev (comma-separated)
# ALLOWED_DEV_EMAILS=you@gmail.com
