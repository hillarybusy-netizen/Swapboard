# ============================================================
# SWAPBOARD ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and should never be committed
#
# Public variables (NEXT_PUBLIC_*) are safe to expose in frontend
# Private variables are only used on the server side
# ============================================================

# ============================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================
# Get these from your Supabase project:
# 1. Go to: Supabase Dashboard > Settings > API
# 2. Copy the Project URL and Keys
#
# NEXT_PUBLIC_SUPABASE_URL is safe to expose (used by browser)
# SUPABASE_SERVICE_ROLE_KEY is private (server-only, for admin operations)
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzAwMDAwMDAwLCJleHAiOjIwMTUzNjAwMDB9.PASTE_YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlvdXItcHJvamVjdC1pZCIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE3MDAwMDAwMDAsImV4cCI6MjAxNTM2MDAwMH0.PASTE_YOUR_SERVICE_ROLE_KEY_HERE

# ============================================================
# APPLICATION CONFIGURATION (Required)
# ============================================================
# Used for:
# - Email verification links
# - Password reset redirects
# - OAuth callback URLs
# - SEO canonical URLs
# - API webhook endpoints
#
# Development:   http://localhost:3000
# Staging:       https://staging.swapboard.ca
# Production:    https://swapboard.ca
#
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# EMAIL SERVICE - RESEND (Required for production)
# ============================================================
# Free email sending service perfect for transactional emails
# 1. Sign up at: https://resend.com
# 2. Go to: Settings > API Keys
# 3. Copy the API Key (format: re_xxxxxxxxxxxx)
#
# Used for:
# - User invitations
# - Password reset emails
# - Shift notifications
# - Swap request notifications
#
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# PAYMENT PROCESSING - STRIPE (Required for production)
# ============================================================
# Stripe handles subscription billing and payments
# Get keys from: https://dashboard.stripe.com/apikeys
#
# Publishable Key (pk_test_* or pk_live_*):
#   - Safe to expose in frontend code
#   - Used for client-side payment operations
#   - Visible in browser console (not a security risk)
#
# Secret Key (sk_test_* or sk_live_*):
#   - NEVER expose in frontend or frontend-visible code
#   - Server-only operations
#   - Protect like a password
#
# Development (Test Mode): Use pk_test_* and sk_test_*
# Production (Live Mode): Use pk_live_* and sk_live_*
#
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# ADMIN & TESTING CONFIGURATION (Optional)
# ============================================================

# Platform admin emails (comma-separated, no spaces)
# These users get full platform admin access
# Example: admin@company.com,manager@company.com
#
PLATFORM_ADMIN_EMAILS=admin@swapboard.local

# Development-only: allow signup with specific emails
# Useful for testing without email verification
# Only active in development environment
# Example: dev@company.com,test@company.com
#
# ALLOWED_DEV_EMAILS=dev@swapboard.local,test@swapboard.local

# ============================================================
# OPTIONAL: ADVANCED CONFIGURATION
# ============================================================

# Database connection pool size (default: 10)
# DATABASE_POOL_SIZE=10

# Enable debug logging (default: false)
# DEBUG=true

# API rate limiting (default: 100 requests per minute)
# API_RATE_LIMIT=100

# ============================================================
# SECURITY NOTES
# ============================================================
# 1. NEVER commit .env.local to version control
#    - It contains sensitive credentials
#    - Use .env.local.example for version control instead
#
# 2. Rotate credentials regularly
#    - Treat API keys like passwords
#    - Revoke old keys in respective dashboards
#
# 3. Use different keys for different environments
#    - Development: test/staging keys (safe to fail)
#    - Production: live keys (careful with changes)
#
# 4. Access control
#    - Keep .env.local secure
#    - Only share with trusted team members
#    - Use .gitignore to prevent accidental commits
#
# 5. Key rotation procedure
#    - Generate new key in dashboard
#    - Update .env.local
#    - Restart application
#    - Revoke old key in dashboard (or keep as backup temporarily)
#
# ============================================================
